{
  "cleanUrls": true,
  "functions": {
    "api/produto.js": {
      "includeFiles": "{produto-template.html,js/supabase-client.js,js/product-render.js}"
    },
    "api/sitemap.js": {
      "includeFiles": "{js/supabase-client.js,js/product-render.js}"
    }
  },
  "rewrites": [
    {
      "source": "/produto/:slug",
      "destination": "/api/produto?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "redirects": [
    {
      "source": "/produto-terco-infantil.html",
      "destination": "/produto/terco-infantil",
      "permanent": true
    },
    {
      "source": "/produto-terco-infantil",
      "destination": "/produto/terco-infantil",
      "permanent": true
    },
    {
      "source": "/produto-terco-pulso.html",
      "destination": "/produto/terco-pulso",
      "permanent": true
    },
    {
      "source": "/produto-terco-pulso",
      "destination": "/produto/terco-pulso",
      "permanent": true
    },
    {
      "source": "/produto-terco-emborrachado.html",
      "destination": "/produto/terco-emborrachado",
      "permanent": true
    },
    {
      "source": "/produto-terco-emborrachado",
      "destination": "/produto/terco-emborrachado",
      "permanent": true
    },
    {
      "source": "/produto-terco-madeira.html",
      "destination": "/produto/terco-madeira",
      "permanent": true
    },
    {
      "source": "/produto-terco-madeira",
      "destination": "/produto/terco-madeira",
      "permanent": true
    },
    {
      "source": "/produto-santinha-aparecida.html",
      "destination": "/produto/santinha-aparecida",
      "permanent": true
    },
    {
      "source": "/produto-santinha-aparecida",
      "destination": "/produto/santinha-aparecida",
      "permanent": true
    },
    {
      "source": "/produto-imagem-aparecida.html",
      "destination": "/produto/imagem-aparecida",
      "permanent": true
    },
    {
      "source": "/produto-imagem-aparecida",
      "destination": "/produto/imagem-aparecida",
      "permanent": true
    },
    {
      "source": "/produto-chaveiro-aparecida.html",
      "destination": "/produto/chaveiro-aparecida",
      "permanent": true
    },
    {
      "source": "/produto-chaveiro-aparecida",
      "destination": "/produto/chaveiro-aparecida",
      "permanent": true
    },
    {
      "source": "/produto-pulseira-sao-bento.html",
      "destination": "/produto/pulseira-sao-bento",
      "permanent": true
    },
    {
      "source": "/produto-pulseira-sao-bento",
      "destination": "/produto/pulseira-sao-bento",
      "permanent": true
    },
    {
      "source": "/produto-terco-corrente-aparecida.html",
      "destination": "/produto/terco-corrente-aparecida",
      "permanent": true
    },
    {
      "source": "/produto-terco-corrente-aparecida",
      "destination": "/produto/terco-corrente-aparecida",
      "permanent": true
    },
    {
      "source": "/produto-terco-infantil-rosa.html",
      "destination": "/produto/terco-infantil",
      "permanent": true
    },
    {
      "source": "/produto-terco-infantil-rosa",
      "destination": "/produto/terco-infantil",
      "permanent": true
    },
    {
      "source": "/produto-pulseira-sao-bento-branco.html",
      "destination": "/#produtos",
      "permanent": true
    },
    {
      "source": "/produto-pulseira-sao-bento-branco",
      "destination": "/#produtos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
